{
  "ci": {
    "collect": {
      "startServerCommand": "python3 scripts/serve_local.py 8080",
      "startServerReadyPattern": "Site local",
      "numberOfRuns": 1,
      "url": [
        "http://127.0.0.1:8080/",
        "http://127.0.0.1:8080/en",
        "http://127.0.0.1:8080/ar",
        "http://127.0.0.1:8080/solutions",
        "http://127.0.0.1:8080/contact",
        "http://127.0.0.1:8080/blog/agent-ia-langgraph-validation-humaine",
        "http://127.0.0.1:8080/securite-du-site",
        "http://127.0.0.1:8080/ar/report-a-vulnerability",
        "http://127.0.0.1:8080/en/ai-search-demo",
        "http://127.0.0.1:8080/ar/trap-the-agent"
      ],
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", {"minScore": 1}],
        "categories:best-practices": ["error", {"minScore": 1}],
        "categories:seo": ["error", {"minScore": 1}],
        "categories:performance": ["error", {"minScore": 0.8}]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
